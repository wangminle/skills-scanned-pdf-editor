  {
    "id": "BEH-001",
    "category": "behavior",
    "mode": "remove",
    "description": "删除区域后输出尺寸不变、框外无变化、框内墨迹被清除",
    "validation": {
      "check_size": true,
      "check_outside_boxes": true,
      "check_inside_dark_pixels": true,
      "max_outside_changes": 500,
      "max_inside_dark_threshold": 180
    }
  },
  {
    "id": "BEH-002",
    "category": "behavior",
    "mode": "remove",
    "description": "full 蒙版模式下整矩形区域被清理（含背景）",
    "cli_args": {"mask-mode": "full"},
    "validation": {
      "check_size": true,
      "check_outside_boxes": true,
      "max_outside_changes": 500
    }
  },
  {
    "id": "BEH-003",
    "category": "behavior",
    "mode": "move",
    "description": "移动后输出尺寸不变，目标位置出现内容",
    "validation": {
      "check_size": true,
      "check_target_has_content": true
    }
  },
  {
    "id": "BEH-004",
    "category": "behavior",
    "mode": "compound",
    "description": "复合操作后源块被清除、目标位置出现源块内容",
    "validation": {
      "check_size": true,
      "check_target_has_content": true,
      "check_source_cleared": true
    }
  },
  {
    "id": "BEH-005",
    "category": "behavior",
    "mode": "replace",
    "description": "替换后输出尺寸不变，目标区域有新内容",
